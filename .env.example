# Copy to both .env (for Docker Compose) and backend/.env (for FastAPI).
# Replace these development-only credentials before using real or sensitive data.
MYSQL_ROOT_PASSWORD=cybertrace-local-root
MYSQL_DATABASE=cybertrace
MYSQL_USER=cybertrace
MYSQL_PASSWORD=cybertrace-local-app
MYSQL_PORT=3306

# MySQL (default for Docker / production):
DATABASE_URL=mysql+pymysql://cybertrace:cybertrace-local-app@127.0.0.1:3306/cybertrace
# SQLite (optional quick-start for local development without Docker):
# DATABASE_URL=sqlite:///./cybertrace.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Investigation Assistant (deterministic offline synthesis by default)
AI_PROVIDER=deterministic
AI_PROVIDER_ENABLED=false
AI_ALLOW_EXTERNAL_DATA=false
AI_MODEL=local-deterministic
# Optional Local LLM (Ollama):
# AI_PROVIDER=ollama
# AI_PROVIDER_ENABLED=true
# AI_PROVIDER_URL=http://127.0.0.1:11434
# AI_MODEL=llama3.1
